// KeyBridge resources (UTF-8). Compiled by build.bat:
//   rc /nologo /I src /I build\obj\release /fo build\obj\release\keybridge.res keybridge.rc
// version.h is generated by build.bat from its [version] argument.
#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// The first icon (lowest ID) is the one Explorer shows for KeyBridge.exe.
IDI_APP         ICON    "../assets/keybridge.ico"
IDI_TRAY_ON     ICON    "../assets/tray-on.ico"
IDI_TRAY_OFF    ICON    "../assets/tray-off.ico"

// Application manifest: resource type 24 (RT_MANIFEST), ID 1
// (CREATEPROCESS_MANIFEST_RESOURCE_ID). The linker runs with /MANIFEST:NO.
1 24 "keybridge.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 292, 172
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "KeyBridge Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Connect this PC to your Mac so you can type on it with your Mac’s keyboard.", IDC_INTRO, 10, 8, 272, 10
    LTEXT           "To find the address and pairing code, click the KeyBridge icon in your Mac’s menu bar and choose “Pair a Windows PC…”.", IDC_STATIC, 10, 22, 272, 18

    LTEXT           "&Mac address:", IDC_STATIC, 10, 52, 64, 8
    EDITTEXT        IDC_HOST, 78, 50, 204, 14, ES_AUTOHSCROLL
    LTEXT           "For example Camerons-MacBook.local or 192.168.1.20", IDC_HOST_HINT, 78, 66, 204, 8

    LTEXT           "&Pairing code:", IDC_STATIC, 10, 86, 64, 8
    EDITTEXT        IDC_CODE, 78, 84, 204, 14, ES_AUTOHSCROLL | ES_UPPERCASE
    LTEXT           "20 letters and numbers, like ABCDE-FGHJK-MNPQR-STVWX", IDC_CODE_HINT, 78, 100, 204, 8

    AUTOCHECKBOX    "&Start KeyBridge when I sign in", IDC_AUTOSTART, 10, 120, 272, 10

    DEFPUSHBUTTON   "Connect", IDOK, 178, 148, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 232, 148, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    KB_VER_MAJOR, KB_VER_MINOR, KB_VER_PATCH, 0
 PRODUCTVERSION KB_VER_MAJOR, KB_VER_MINOR, KB_VER_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Cameron MacLaurin"
            VALUE "FileDescription",  "KeyBridge"
            VALUE "FileVersion",      KB_VER_STRING
            VALUE "InternalName",     "KeyBridge"
            VALUE "LegalCopyright",   "© 2026 Cameron MacLaurin"
            VALUE "OriginalFilename", "KeyBridge.exe"
            VALUE "ProductName",      "KeyBridge"
            VALUE "ProductVersion",   KB_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// KeyBridge resources (UTF-8). Compiled by build.bat:
//   rc /nologo /I src /I build\obj\release /fo build\obj\release\keybridge.res keybridge.rc
// version.h is generated by build.bat from its [version] argument.
#pragma code_page(65001)

#include <windows.h>
#include "resource.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

// The first icon (lowest ID) is the one Explorer shows for KeyBridge.exe.
IDI_APP         ICON    "../assets/keybridge.ico"
IDI_TRAY_ON     ICON    "../assets/tray-on.ico"
IDI_TRAY_OFF    ICON    "../assets/tray-off.ico"

// Application manifest: resource type 24 (RT_MANIFEST), ID 1
// (CREATEPROCESS_MANIFEST_RESOURCE_ID). The linker runs with /MANIFEST:NO.
1 24 "keybridge.manifest"

// Setup: pick a Mac found on the network (or type an address), then Pair.
// If the DNS-SD APIs are missing, main.c hides the list and moves the
// manual-entry controls up.
IDD_SETUP DIALOGEX 0, 0, 262, 226
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Pair with your Mac"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "On your Mac, click the KeyBridge menu bar icon → Pair a Windows PC…", IDC_HELP_TEXT, 10, 8, 242, 18
    LTEXT           "&Macs on your network:", IDC_LIST_LABEL, 10, 30, 242, 8
    LISTBOX         IDC_MAC_LIST, 10, 41, 242, 64, LBS_NOTIFY | LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Or enter the address manually:", IDC_MANUAL_LABEL, 10, 113, 242, 8
    EDITTEXT        IDC_HOST, 10, 124, 242, 14, ES_AUTOHSCROLL
    LTEXT           "For example Camerons-MacBook.local, 192.168.1.20 or host:port", IDC_HOST_HINT, 10, 140, 242, 8
    AUTOCHECKBOX    "&Start KeyBridge when I sign in", IDC_AUTOSTART, 10, 158, 242, 10
    LTEXT           "", IDC_SETUP_STATUS, 10, 174, 242, 24, SS_NOPREFIX
    DEFPUSHBUTTON   "&Pair", IDOK, 148, 204, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 202, 204, 50, 14
END

// Compare: both screens must show the same number. Confirm is not IDOK
// and not the default button, so Enter can't confirm without looking.
IDD_COMPARE DIALOGEX 0, 0, 230, 134
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pair with your Mac"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CMP_TITLE, 10, 10, 210, 10, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "Make sure your Mac shows the same number.", IDC_CMP_HINT, 10, 24, 210, 10
    CTEXT           "", IDC_CMP_NUMBER, 10, 40, 210, 34, SS_NOPREFIX | SS_CENTERIMAGE
    CTEXT           "", IDC_CMP_STATUS, 10, 82, 210, 10, SS_NOPREFIX
    PUSHBUTTON      "&Confirm", IDC_CMP_CONFIRM, 116, 110, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 110, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    KB_VER_MAJOR, KB_VER_MINOR, KB_VER_PATCH, 0
 PRODUCTVERSION KB_VER_MAJOR, KB_VER_MINOR, KB_VER_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Cameron MacLaurin"
            VALUE "FileDescription",  "KeyBridge"
            VALUE "FileVersion",      KB_VER_STRING
            VALUE "InternalName",     "KeyBridge"
            VALUE "LegalCopyright",   "© 2026 Cameron MacLaurin"
            VALUE "OriginalFilename", "KeyBridge.exe"
            VALUE "ProductName",      "KeyBridge"
            VALUE "ProductVersion",   KB_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

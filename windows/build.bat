@echo off
rem ---------------------------------------------------------------------------
rem Build KeyBridge for Windows with MSVC (x64). Run from a shell where
rem vcvars64.bat has already been called (the CI workflow does this).
rem
rem   build.bat [version] [selftest^|preview]
rem
rem   build.bat 1.2.3           -> windows\build\KeyBridge.exe
rem   build.bat 1.2.3 preview   -> windows\build\KeyBridge-preview.exe
rem                                (KEYBRIDGE_UI_PREVIEW: --preview <state> shows
rem                                the tray flyout with fake state; never shipped)
rem   build.bat 1.2.3 selftest  -> windows\build\KeyBridge-selftest.exe
rem                                (docs/PROTOCOL.md Appendix A.2/A.4/A.5 and
rem                                docs/UPDATES.md section 6 conformance hooks;
rem                                console app; never shipped)
rem
rem version defaults to 0.0.0. A leading "v" and a "-suffix" are accepted;
rem only MAJOR.MINOR.PATCH (each 0..65535) goes into VERSIONINFO.
rem Exits non-zero if any step fails.
rem ---------------------------------------------------------------------------
setlocal EnableExtensions DisableDelayedExpansion

set "VERSION=%~1"
set "MODE=%~2"
if /i "%VERSION%"=="selftest" (
    set "VERSION=%~2"
    set "MODE=selftest"
)
if /i "%VERSION%"=="preview" (
    set "VERSION=%~2"
    set "MODE=preview"
)
if "%VERSION%"=="" set "VERSION=0.0.0"
if not "%MODE%"=="" if /i not "%MODE%"=="selftest" if /i not "%MODE%"=="preview" (
    echo error: unknown option "%MODE%". Usage: build.bat [version] [selftest^|preview] 1>&2
    exit /b 2
)
if /i "%VERSION:~0,1%"=="v" set "VERSION=%VERSION:~1%"

set "VMAJ="
set "VMIN="
set "VPAT="
for /f "tokens=1-3 delims=.-+" %%a in ("%VERSION%") do (
    set "VMAJ=%%a"
    set "VMIN=%%b"
    set "VPAT=%%c"
)
if not defined VMAJ set "VMAJ=0"
if not defined VMIN set "VMIN=0"
if not defined VPAT set "VPAT=0"
call :check_part "%VMAJ%" || exit /b 2
call :check_part "%VMIN%" || exit /b 2
call :check_part "%VPAT%" || exit /b 2

where cl.exe >nul 2>&1 || (
    echo error: cl.exe not found. Run vcvars64.bat or use an "x64 Native Tools" prompt. 1>&2
    exit /b 1
)
where rc.exe >nul 2>&1 || (
    echo error: rc.exe not found. Run vcvars64.bat or use an "x64 Native Tools" prompt. 1>&2
    exit /b 1
)

rem Work from windows\ with relative paths (no spaces), whatever the caller's cwd.
pushd "%~dp0" || exit /b 1

set "OUT=build"
rem Shipping app by default; the preview build adds src\preview.c and the define.
set "OBJ=build\obj\release"
set "EXE=KeyBridge.exe"
set "DEFS="
set "EXTRA="
if /i "%MODE%"=="selftest" set "OBJ=build\obj\selftest"
if /i "%MODE%"=="preview" (
    set "OBJ=build\obj\preview"
    set "EXE=KeyBridge-preview.exe"
    set "DEFS=/DKEYBRIDGE_UI_PREVIEW"
    set "EXTRA=src\preview.c"
)
if not exist "%OBJ%\" mkdir "%OBJ%" || goto :fail

set "CFLAGS=/nologo /O2 /MT /W4 /sdl /GS /guard:cf /Gy /Gw /DUNICODE /D_UNICODE /DWIN32_LEAN_AND_MEAN"
rem flyout.cpp is the only C++ file: no exceptions, no RTTI, SDK headers quiet.
set "CXXFLAGS=%CFLAGS% /EHs-c- /GR- /external:anglebrackets /external:W0"
set "LFLAGS=/NOLOGO /DYNAMICBASE /NXCOMPAT /HIGHENTROPYVA /GUARD:CF /CETCOMPAT /OPT:REF /OPT:ICF /INCREMENTAL:NO"
set "LIBS=ws2_32.lib user32.lib shell32.lib gdi32.lib bcrypt.lib crypt32.lib comctl32.lib advapi32.lib winhttp.lib"
rem Protocol, pairing, discovery and update-verification code shared by both
rem builds (Appendix A and UPDATES.md section 6: the selftest must run the same
rem code as the app).
set "CORE=src\kbp2.c src\kbclip.c src\pairing.c src\discovery.c src\crypto.c src\kbutil.c src\update.c src\update_manifest.c"

if /i "%MODE%"=="selftest" goto :selftest

rem ---- Shipping app (or the UI preview) ---------------------------------------
echo Building %EXE% %VMAJ%.%VMIN%.%VPAT%

> "%OBJ%\version.h" echo /* Generated by build.bat. */
>>"%OBJ%\version.h" echo #define KB_VER_MAJOR %VMAJ%
>>"%OBJ%\version.h" echo #define KB_VER_MINOR %VMIN%
>>"%OBJ%\version.h" echo #define KB_VER_PATCH %VPAT%
>>"%OBJ%\version.h" echo #define KB_VER_STRING "%VMAJ%.%VMIN%.%VPAT%"

rc /nologo /I src /I %OBJ% /fo %OBJ%\keybridge.res keybridge.rc || goto :fail

if exist "%OUT%\%EXE%" del /q "%OUT%\%EXE%" || goto :fail
rem The tray flyout (C++), compiled on its own so /TP never touches the C files.
rem d2d1, dwrite, dwmapi and shcore are loaded at run time: no new libraries.
cl /c %CXXFLAGS% %DEFS% /I %OBJ% /Fo%OBJ%\flyout.obj /Tpsrc\flyout.cpp || goto :fail
cl %CFLAGS% %DEFS% /I %OBJ% /Fo%OBJ%\ /Fe%OUT%\%EXE% ^
    src\main.c src\worker.c src\clipboard.c src\inject.c src\config.c %EXTRA% %CORE% ^
    %OBJ%\flyout.obj %OBJ%\keybridge.res ^
    /link %LFLAGS% /SUBSYSTEM:WINDOWS /MANIFEST:NO %LIBS% || goto :fail
if not exist "%OUT%\%EXE%" goto :fail

echo Built windows\%OUT%\%EXE%
popd
exit /b 0

rem ---- Conformance selftest (Appendix A.2, A.4, A.5) ------------------------
:selftest
echo Building KeyBridge-selftest.exe %VMAJ%.%VMIN%.%VPAT%

if exist "%OUT%\KeyBridge-selftest.exe" del /q "%OUT%\KeyBridge-selftest.exe" || goto :fail
cl %CFLAGS% /DKEYBRIDGE_SELFTEST /Fo%OBJ%\ /Fe%OUT%\KeyBridge-selftest.exe ^
    src\selftest.c %CORE% ^
    /link %LFLAGS% /SUBSYSTEM:CONSOLE /MANIFEST:EMBED %LIBS% || goto :fail
if not exist "%OUT%\KeyBridge-selftest.exe" goto :fail

echo Built windows\%OUT%\KeyBridge-selftest.exe
popd
exit /b 0

:fail
echo error: build failed 1>&2
popd
exit /b 1

rem ---- helpers ---------------------------------------------------------------
rem A version part must be a plain decimal number 0..65535 (no leading zeros).
:check_part
set "KB_PART="
set /a "KB_PART=%~1" 2>nul
if not "%KB_PART%"=="%~1" goto :bad_part
if %KB_PART% GTR 65535 goto :bad_part
exit /b 0
:bad_part
echo error: version "%VERSION%" must look like MAJOR.MINOR.PATCH with numbers 0..65535 1>&2
exit /b 1
